/* ==================================
   ACTUALIZACIÓN DEL JUEGO
================================== */

function updateGame() {

  if (
    !playing ||
    paused
  )
    return;


  const delta = 0.016;


  const forward =
    (keys.w ? 1 : 0) -
    (keys.s ? 1 : 0);


  const sideways =
    (keys.d ? 1 : 0) -
    (keys.a ? 1 : 0);


  const speed =
    characters[
      selectedCharacter
    ].speed;


  player.position.z +=
    forward *
    speed *
    delta;


  player.position.x +=
    sideways *
    speed *
    delta;


  player.position.x =
    Math.max(
      -255,
      Math.min(
        255,
        player.position.x
      )
    );


  player.position.z =
    Math.max(
      -255,
      Math.min(
        255,
        player.position.z
      )
    );


  collectItems();


  /* Movimiento de espíritus */

  for (
    const spirit of spirits
  ) {

    if (
      !spirit.active
    )
      continue;


    spirit.phase +=
      delta;


    if (
      Math.random() < .006
    ) {

      spirit.direction
        .applyAxisAngle(
          new THREE.Vector3(
            0,
            1,
            0
          ),
          (Math.random() - .5) * 1.8
        )
        .normalize();

    }


    spirit.object
      .position
      .addScaledVector(
        spirit.direction,
        delta *
        (.7 +
        spirit.level * .14)
      );


    spirit.object.position.x =
      Math.max(
        -255,
        Math.min(
          255,
          spirit.object.position.x
        )
      );


    spirit.object.position.z =
      Math.max(
        -255,
        Math.min(
          255,
          spirit.object.position.z
        )
      );


    spirit.object.position.y =
      .3 +
      Math.sin(
        spirit.phase * 2
      ) * .25;


    if (
      player.position.distanceTo(
        spirit.object.position
      ) < 2.4
    ) {

      health =
        Math.max(
          0,
          health -
          delta *
          (1 +
          spirit.level * .3)
        );

    }

  }


  /* Día y noche */

  gameTime += delta;

  const daylight =
    (
      Math.sin(
        gameTime * .12
      ) + 1
    ) / 2;


  sun.intensity =
    .35 +
    daylight * 2.2;


  scene.background.setHSL(
    .62,
    .44,
    .025 +
    daylight * .055
  );


  scene.fog.color.copy(
    scene.background
  );


  /* Si se queda sin vida */

  if (
    health <= 0
  ) {

    health = 100;

    player.position.set(
      0,
      0,
      0
    );

  }


  updateHUD();

  drawMap();


  /* Cámara */

  const target =
    new THREE.Vector3(
      player.position.x,
      1.3,
      player.position.z
    );


  let distance = 9;

  if (
    cameraMode === 1
  )
    distance = 16;

  if (
    cameraMode === 2
  )
    distance = 4;


  const height =
    cameraMode === 2
      ? 2.8
      : 5;


  camera.position.lerp(

    target.clone().add(
      new THREE.Vector3(
        0,
        height,
        distance
      )
    ),

    .09

  );


  camera.lookAt(
    target
  );

}


/* ==================================
   BUCLE PRINCIPAL
================================== */

function gameLoop() {

  requestAnimationFrame(
    gameLoop
  );

  updateGame();

  renderer.render(
    scene,
    camera
  );

}

