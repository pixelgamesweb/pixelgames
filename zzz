<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport"
        content="width=device-width,initial-scale=1,user-scalable=no">
  <title>Spirit Wilds</title>

  <style>
    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
    }

    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #02030a;
      color: white;
      font-family: Arial, sans-serif;
    }

    #game {
      position: fixed;
      inset: 0;
    }

    button {
      border: 1px solid #ffffff30;
      border-radius: 14px;
      background: #050505;
      color: #62aaff;
      font-weight: bold;
      padding: 13px 18px;
      cursor: pointer;
    }

    button:active {
      transform: scale(.97);
    }

    /* MENÚ */

    .screen {
      position: fixed;
      inset: 0;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: center;

      background:
        radial-gradient(
          circle at 20% 20%,
          #7d4cff55,
          transparent 30%
        ),
        radial-gradient(
          circle at 80% 25%,
          #258cff44,
          transparent 30%
        ),
        radial-gradient(
          circle at 50% 100%,
          #bd45ff33,
          transparent 40%
        ),
        linear-gradient(
          135deg,
          #02020a,
          #15102e,
          #03040a
        );
    }

    .panel {
      width: min(92vw, 720px);
      max-height: 90vh;
      overflow: auto;
      padding: 30px;
      border-radius: 28px;
      background: #050509e8;
      border: 1px solid #ffffff22;
      box-shadow: 0 30px 100px #000;
    }

    h1 {
      margin: 0;
      text-align: center;
      font-size: clamp(45px, 9vw, 80px);
      letter-spacing: -3px;
    }

    .subtitle {
      text-align: center;
      opacity: .75;
      line-height: 1.6;
      margin: 10px auto 25px;
      max-width: 600px;
    }

    .mainButton {
      display: block;
      width: 100%;
      margin: 10px 0;
      padding: 17px;
      font-size: 18px;
    }

    .row {
      display: flex;
      gap: 10px;
    }

    .row button {
      flex: 1;
    }

    /* HUD */

    #hud {
      display: none;
      position: fixed;
      z-index: 10;
      top: 12px;
      left: 12px;
      right: 12px;
      justify-content: space-between;
      align-items: flex-start;
      pointer-events: none;
    }

    #stats {
      background: #000b;
      border: 1px solid #ffffff25;
      border-radius: 15px;
      padding: 11px;
      min-width: 300px;
      font-size: 13px;
      line-height: 1.6;
    }

    .health {
      height: 10px;
      width: 100%;
      margin: 3px 0 5px;
      background: #42151b;
      border-radius: 10px;
      overflow: hidden;
    }

    #healthBar {
      width: 100%;
      height: 100%;
      background: #42e37a;
      transition: width .2s;
    }

    #topButtons {
      display: flex;
      gap: 7px;
      pointer-events: auto;
    }

    #topButtons button {
      width: 46px;
      height: 46px;
      padding: 0;
      font-size: 18px;
    }

    /* CONTROLES TABLET */

    #controls {
      display: none;
      position: fixed;
      z-index: 11;
      left: 0;
      right: 0;
      bottom: 12px;
      height: 160px;
      pointer-events: none;
    }

    #joystick {
      position: absolute;
      left: 15px;
      bottom: 0;
      width: 145px;
      height: 145px;
      border-radius: 50%;
      background: #000a;
      border: 2px solid #ffffff22;
      pointer-events: auto;
    }

    #joystickKnob {
      position: absolute;
      left: 43px;
      top: 43px;
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: #111;
      border: 2px solid #ffffff35;
    }

    #actionButtons {
      position: absolute;
      right: 14px;
      bottom: 4px;
      display: grid;
      grid-template-columns: repeat(2, 82px);
      gap: 8px;
      pointer-events: auto;
    }

    #actionButtons button {
      height: 62px;
      padding: 5px;
      font-size: 10px;
    }

    /* MAPA */

    #miniMap {
      display: none;
      position: fixed;
      z-index: 15;
      right: 65px;
      top: 65px;
      width: 210px;
      height: 210px;
      border-radius: 16px;
      overflow: hidden;
      background: #07100ddd;
      border: 2px solid #ffffff30;
    }

    #miniMap canvas {
      width: 100%;
      height: 100%;
    }

    /* PAUSA */

    #pauseScreen {
      display: none;
    }

    /* INFORMACIÓN */

    #infoScreen,
    #shopScreen {
      display: none;
    }

    .spiritItem {
      margin: 7px 0;
      padding: 11px;
      border-radius: 12px;
      background: #11111a;
      border: 1px solid #ffffff10;
    }

    .close {
      float: right;
      color: white;
    }

    @media(max-width:600px) {
      #stats {
        min-width: 245px;
        font-size: 11px;
      }

      .panel {
        padding: 20px;
      }
    }
  </style>
</head>

<body>

<div id="game"></div>


<!-- =========================
     MENÚ PRINCIPAL
========================= -->

<section id="menuScreen" class="screen">

  <div class="panel">

    <h1>Spirit Wilds</h1>

    <p class="subtitle">
      Explora un enorme mundo 3D, descubre zonas diferentes,
      encuentra espíritus, recoge Éter y consigue capturarlos.
    </p>

    <button
      id="playButton"
      class="mainButton">
      JUGAR
    </button>

    <div class="row">

      <button id="characterButton">
        CAMBIAR PERSONAJE
      </button>

      <button id="informationButton">
        ESPÍRITUS
      </button>

    </div>

    <button
      id="shopButton"
      class="mainButton">
      TIENDA
    </button>

  </div>

</section>


<!-- =========================
     INFORMACIÓN
========================= -->

<section
  id="infoScreen"
  class="screen">

  <div class="panel">

    <button
      id="closeInfo"
      class="close">
      CERRAR
    </button>

    <h2>Los 50 espíritus</h2>

    <p>
      Cada espíritu tiene un nivel diferente.
      Acércate, debilítalo y utiliza una Étercápsula.
    </p>

    <div id="spiritList"></div>

  </div>

</section>


<!-- =========================
     TIENDA
========================= -->

<section
  id="shopScreen"
  class="screen">

  <div class="panel">

    <button
      id="closeShop"
      class="close">
      CERRAR
    </button>

    <h2>Tienda</h2>

    <div class="spiritItem">
      <b>Skin Astral</b><br>
      2,99 €
      <button
        class="buyButton"
        data-product="skin_astral">
        COMPRAR
      </button>
    </div>

    <div class="spiritItem">
      <b>100 Étercápsulas</b><br>
      0,99 €
      <button
        class="buyButton"
        data-product="capsulas_100">
        COMPRAR
      </button>
    </div>

    <div class="spiritItem">
      <b>Pase Guardián</b><br>
      2,99 €
      <button
        class="buyButton"
        data-product="pase_guardian">
        COMPRAR
      </button>
    </div>

  </div>

</section>


<!-- =========================
     PAUSA
========================= -->

<section
  id="pauseScreen"
  class="screen">

  <div class="panel">

    <h2>PAUSA</h2>

    <button
      id="resumeButton"
      class="mainButton">
      CONTINUAR
    </button>

    <button
      id="backButton"
      class="mainButton">
      VOLVER
    </button>

  </div>

</section>


<!-- =========================
     HUD
========================= -->

<div id="hud">

  <div id="stats">

    ❤️ Vida:
    <b id="healthText">100%</b>

    <div class="health">
      <div id="healthBar"></div>
    </div>

    🔮 Cápsulas:
    <b id="capsulesText">25</b>

    · ✨ Éter:
    <b id="etherText">0</b>

    · 👻 Capturados:
    <b id="caughtText">0</b>

    · ⭐ Nivel:
    <b id="levelText">1</b>

    <br>

    🌍 Zona:
    <b id="zoneText">Pradera Central</b>

  </div>


  <div id="topButtons">

    <button id="saveButton">
      💾
    </button>

    <button id="mapButton">
      ▦
    </button>

    <button id="pauseButton">
      Ⅱ
    </button>

  </div>

</div>


<!-- =========================
     MAPA
========================= -->

<div id="miniMap">
  <canvas
    id="mapCanvas"
    width="210"
    height="210">
  </canvas>
</div>


<!-- =========================
     CONTROLES TABLET
========================= -->

<div id="controls">

  <div id="joystick">
    <div id="joystickKnob"></div>
  </div>


  <div id="actionButtons">

    <button id="throwButton">
      LANZAR<br>Q
    </button>

    <button id="captureButton">
      ATRAPAR<br>E
    </button>

    <button id="collectButton">
      RECOGER<br>ÉTER
    </button>

    <button id="cameraButton">
      CÁMARA<br>C
    </button>

  </div>

</div>


<!-- =========================
     MOTOR 3D
========================= -->

<script type="module">

import * as THREE from
"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js";


/* ==================================
   ESCENA
================================== */

const scene =
  new THREE.Scene();

scene.background =
  new THREE.Color(0x07101b);

scene.fog =
  new THREE.Fog(
    0x07101b,
    30,
    280
  );


/* ==================================
   CÁMARA
================================== */

const camera =
  new THREE.PerspectiveCamera(
    65,
    innerWidth / innerHeight,
    0.1,
    1200
  );

camera.position.set(
  0,
  5,
  10
);


/* ==================================
   RENDER
================================== */

const renderer =
  new THREE.WebGLRenderer({
    antialias: true
  });

renderer.setSize(
  innerWidth,
  innerHeight
);

renderer.setPixelRatio(
  Math.min(
    devicePixelRatio,
    2
  )
);

renderer.shadowMap.enabled = true;

document
  .getElementById("game")
  .appendChild(
    renderer.domElement
  );


/* ==================================
   ILUMINACIÓN
================================== */

scene.add(
  new THREE.HemisphereLight(
    0xaacaff,
    0x162315,
    1.5
  )
);

const sun =
  new THREE.DirectionalLight(
    0xffedc4,
    2.4
  );

sun.position.set(
  -70,
  100,
  40
);

sun.castShadow = true;

scene.add(sun);


/* ==================================
   TERRENO
================================== */

const WORLD_SIZE = 520;

const ground =
  new THREE.Mesh(
    new THREE.PlaneGeometry(
      WORLD_SIZE,
      WORLD_SIZE
    ),
    new THREE.MeshStandardMaterial({
      color: 0x183625,
      roughness: 1
    })
  );

ground.rotation.x =
  -Math.PI / 2;

ground.receiveShadow = true;

scene.add(ground);


/* ==================================
   ZONAS DEL MAPA
================================== */

const zones = [

  {
    name: "Pradera Central",
    x: 0,
    z: 0,
    radius: 105,
    color: 0x355e2e
  },

  {
    name: "Bosque Sombrío",
    x: -150,
    z: -135,
    radius: 110,
    color: 0x123b25
  },

  {
    name: "Valle de Nieve",
    x: 155,
    z: -135,
    radius: 105,
    color: 0xb8d4dc
  },

  {
    name: "Desierto Dorado",
    x: -155,
    z: 155,
    radius: 105,
    color: 0x9b7047
  },

  {
    name: "Tierras Volcánicas",
    x: 155,
    z: 155,
    radius: 105,
    color: 0x451b1b
  },

  {
    name: "Pantano Azul",
    x: 0,
    z: 205,
    radius: 75,
    color: 0x173d45
  },

  {
    name: "Montañas",
    x: 0,
    z: -220,
    radius: 90,
    color: 0x394454
  }

];


for (const zone of zones) {

  const mesh =
    new THREE.Mesh(
      new THREE.CircleGeometry(
        zone.radius,
        72
      ),
      new THREE.MeshStandardMaterial({
        color: zone.color,
        roughness: 1
      })
    );

  mesh.rotation.x =
    -Math.PI / 2;

  mesh.position.set(
    zone.x,
    0.01,
    zone.z
  );

  scene.add(mesh);
}


/* ==================================
   ÁRBOLES
================================== */

function createTree(
  x,
  z,
  scale
) {

  const tree =
    new THREE.Group();


  const trunk =
    new THREE.Mesh(
      new THREE.CylinderGeometry(
        .25,
        .48,
        3.4,
        10
      ),
      new THREE.MeshStandardMaterial({
        color: 0x50321e
      })
    );

  trunk.position.y = 1.7;

  tree.add(trunk);


  for (
    let i = 0;
    i < 4;
    i++
  ) {

    const leaves =
      new THREE.Mesh(
        new THREE.ConeGeometry(
          2.1 - i * .28,
          3.1,
          12
        ),
        new THREE.MeshStandardMaterial({
          color:
            i % 2
              ? 0x155c31
              : 0x0d4c2b
        })
      );

    leaves.position.y =
      3.2 + i * 1.2;

    tree.add(leaves);
  }


  tree.position.set(
    x,
    0,
    z
  );

  tree.scale.setScalar(
    scale
  );

  scene.add(tree);
}


/* ==================================
   ROCAS
================================== */

function createRock(
  x,
  z,
  scale
) {

  const rock =
    new THREE.Mesh(
      new THREE.DodecahedronGeometry(
        1.5 * scale
      ),
      new THREE.MeshStandardMaterial({
        color: 0x62686d
      })
    );

  rock.position.set(
    x,
    .7 * scale,
    z
  );

  scene.add(rock);
}


/* ==================================
   ARBUSTOS
================================== */

function createBush(
  x,
  z
) {

  const bush =
    new THREE.Group();

  for (
    let i = 0;
    i < 6;
    i++
  ) {

    const leaf =
      new THREE.Mesh(
        new THREE.SphereGeometry(
          .7,
          10,
          8
        ),
        new THREE.MeshStandardMaterial({
          color: 0x0d6a36
        })
      );

    leaf.position.set(
      (Math.random() - .5) * 1.6,
      .6 + Math.random() * .6,
      (Math.random() - .5) * 1.6
    );

    bush.add(leaf);
  }

  bush.position.set(
    x,
    0,
    z
  );

  scene.add(bush);
}


/* ==================================
   GENERAR NATURALEZA
================================== */

for (
  let i = 0;
  i < 330;
  i++
) {

  const x =
    (Math.random() - .5) * 500;

  const z =
    (Math.random() - .5) * 500;

  if (
    Math.hypot(x, z) < 15
  ) {
    continue;
  }

  createTree(
    x,
    z,
    .5 + Math.random()
  );

  if (i % 3 === 0) {

    createRock(
      x + 2,
      z + 2,
      .5 + Math.random()
    );

  }

  if (i % 4 === 0) {

    createBush(
      x - 2,
      z + 3
    );

  }
}


/* ==================================
   50 ESPÍRITUS
================================== */

const spiritNames = [

  "Bruma",
  "Frost",
  "Volt",
  "Umbra",
  "Terra",
  "Luma",
  "Nébula",
  "Rayo",
  "Moss",
  "Flare",
  "Aqua",
  "Cinder",
  "Gale",
  "Bloom",
  "Rune",
  "Echo",
  "Nova",
  "Glace",
  "Ember",
  "Mistral",
  "Solaris",
  "Lunar",
  "Thorn",
  "Pebble",
  "Mist",
  "Spark",
  "Coral",
  "Shade",
  "Breeze",
  "Flint",
  "Willow",
  "Comet",
  "Dusk",
  "Aurora",
  "Vine",
  "Storm",
  "Quartz",
  "Ash",
  "River",
  "Cloud",
  "Pyro",
  "Frostbite",
  "Glow",
  "Magma",
  "Leaf",
  "Star",
  "Thunder",
  "Crystal",
  "Spiritus",
  "Zen"

];

const spiritColors = [
  0x8effc4,
  0x9eeaff,
  0xfff34d,
  0xb66cff,
  0xff835d
];

const spirits = [];


for (
  let i = 0;
  i < 50;
  i++
) {

  const spirit =
    new THREE.Group();

  const color =
    spiritColors[
      i % spiritColors.length
    ];


  const light =
    new THREE.PointLight(
      color,
      1.5,
      9
    );

  light.position.y = 2;

  spirit.add(light);


  const body =
    new THREE.Mesh(
      new THREE.IcosahedronGeometry(
        .72,
        2
      ),
      new THREE.MeshStandardMaterial({
        color,
        emissive: color,
        emissiveIntensity: 1,
        transparent: true,
        opacity: .83
      })
    );

  body.position.y = 1.8;

  spirit.add(body);


  spirit.position.set(
    (Math.random() - .5) * 490,
    0,
    (Math.random() - .5) * 490
  );

  scene.add(spirit);


  spirits.push({

    object: spirit,

    name: spiritNames[i],

    level:
      1 + Math.floor(i / 10),

    health:
      100 + Math.floor(i / 10) * 25,

    active: true,

    phase:
      Math.random() * 10,

    direction:
      new THREE.Vector3(
        Math.random() - .5,
        0,
        Math.random() - .5
      ).normalize()

  });

}


/* ==================================
   ÉTER Y CÁPSULAS
================================== */

const etherItems = [];
const capsules = [];


function createResource(
  type,
  x,
  z
) {

  const group =
    new THREE.Group();

  const color =
    type === "ether"
      ? 0x7f6cff
      : 0xffd45a;


  const crystal =
    new THREE.Mesh(
      new THREE.IcosahedronGeometry(
        .35,
        1
      ),
      new THREE.MeshStandardMaterial({
        color,
        emissive: color,
        emissiveIntensity: 1.4
      })
    );

  crystal.position.y = .8;

  group.add(crystal);

  group.position.set(
    x,
    0,
    z
  );

  scene.add(group);

  return group;
}


for (
  let i = 0;
  i < 140;
  i++
) {

  etherItems.push({

    object:
      createResource(
        "ether",
        (Math.random() - .5) * 500,
        (Math.random() - .5) * 500
      ),

    active: true

  });

}


for (
  let i = 0;
  i < 90;
  i++
) {

  capsules.push({

    object:
      createResource(
        "capsule",
        (Math.random() - .5) * 500,
        (Math.random() - .5) * 500
      ),

    active: true

  });

}


/* ==================================
   PERSONAJE
================================== */

const characters = [

  {
    name: "Explorador",
    speed: 5.2,
    color: 0x2e78d8
  },

  {
    name: "Guardabosques",
    speed: 6.3,
    color: 0x3b9b54
  },

  {
    name: "Nómada",
    speed: 5.7,
    color: 0xc28a3a
  },

  {
    name: "Astral",
    speed: 5.1,
    color: 0x7d54e8
  }

];

let selectedCharacter = 0;


function createPlayer() {

  const player =
    new THREE.Group();


  const skin =
    new THREE.MeshStandardMaterial({
      color: 0xd79b74
    });

  const clothes =
    new THREE.MeshStandardMaterial({
      color:
        characters[
          selectedCharacter
        ].color
    });

  const pants =
    new THREE.MeshStandardMaterial({
      color: 0x202638
    });


  const head =
    new THREE.Mesh(
      new THREE.SphereGeometry(
        .5,
        20,
        16
      ),
      skin
    );

  head.position.y = 2.45;

  player.add(head);


  const body =
    new THREE.Mesh(
      new THREE.BoxGeometry(
        .78,
        1.05,
        .54
      ),
      clothes
    );

  body.position.y = 1.55;

  player.add(body);


  for (
    const x of [-.24, .24]
  ) {

    const leg =
      new THREE.Mesh(
        new THREE.BoxGeometry(
          .25,
          .9,
          .3
        ),
        pants
      );

    leg.position.set(
      x,
      .63,
      0
    );

    player.add(leg);

  }


  return player;
}


const player =
  createPlayer();

scene.add(player);


/* ==================================
   ESTADO DEL JUEGO
================================== */

let health = 100;
let capsuleCount = 25;
let etherCount = 0;
let capturedCount = 0;
let playerLevel = 1;

let playing = false;
let paused = false;

let gameTime = 0;

let cameraMode = 0;

const keys = {
  w: false,
  a: false,
  s: false,
  d: false
};


/* ==================================
   ZONA ACTUAL
================================== */

function getCurrentZone(
  x,
  z
) {

  let closest =
    zones[0];

  let distance =
    Infinity;

  for (
    const zone of zones
  ) {

    const d =
      (x - zone.x) ** 2 +
      (z - zone.z) ** 2;

    if (d < distance) {

      distance = d;
      closest = zone;

    }

  }

  return closest.name;
}


/* ==================================
   ACTUALIZAR HUD
================================== */

function updateHUD() {

  document.getElementById(
    "healthText"
  ).textContent =
    Math.round(health) + "%";


  document.getElementById(
    "healthBar"
  ).style.width =
    health + "%";


  document.getElementById(
    "capsulesText"
  ).textContent =
    capsuleCount;


  document.getElementById(
    "etherText"
  ).textContent =
    etherCount;


  document.getElementById(
    "caughtText"
  ).textContent =
    capturedCount;


  document.getElementById(
    "levelText"
  ).textContent =
    playerLevel;


  document.getElementById(
    "zoneText"
  ).textContent =
    getCurrentZone(
      player.position.x,
      player.position.z
    );

}


/* ==================================
   RECOGER OBJETOS
================================== */

function collectItems() {

  for (
    const item of etherItems
  ) {

    if (
      item.active &&
      player.position.distanceTo(
        item.object.position
      ) < 2.5
    ) {

      item.active = false;
      item.object.visible = false;

      etherCount += 5;

    }

  }


  for (
    const item of capsules
  ) {

    if (
      item.active &&
      player.position.distanceTo(
        item.object.position
      ) < 2.5
    ) {

      item.active = false;
      item.object.visible = false;

      capsuleCount += 2;

    }

  }

}


/* ==================================
   ESPÍRITU MÁS CERCANO
================================== */

function nearestSpirit() {

  let closest = null;
  let distance = Infinity;

  for (
    const spirit of spirits
  ) {

    if (!spirit.active)
      continue;

    const d =
      player.position.distanceTo(
        spirit.object.position
      );

    if (d < distance) {

      distance = d;
      closest = spirit;

    }

  }

  return {
    spirit: closest,
    distance
  };

}


/* ==================================
   LANZAR
================================== */

function throwSpirit() {

  if (
    capsuleCount <= 0
  )
    return;


  const result =
    nearestSpirit();


  if (
    !result.spirit ||
    result.distance > 10
  )
    return;


  capsuleCount--;

  result.spirit.health =
    Math.max(
      0,
      result.spirit.health - 40
    );

}


/* ==================================
   ATRAPAR
================================== */

function captureSpirit() {

  if (
    capsuleCount <= 0
  )
    return;


  const result =
    nearestSpirit();


  if (
    !result.spirit ||
    result.distance > 7
  )
    return;


  capsuleCount--;


  const chance =
    .32 +
    playerLevel * .055 +
    (result.spirit.health < 70
      ? .22
      : 0);


  if (
    Math.random() < chance
  ) {

    result.spirit.active =
      false;

    result.spirit.object.visible =
      false;

    capturedCount++;

    playerLevel =
      1 +
      Math.floor(
        capturedCount / 10
      );

  } else {

    health =
      Math.max(
        0,
        health -
        (5 + result.spirit.level)
      );

  }

}


