<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no">
<title>Spirit 3000</title>

<style>
*{box-sizing:border-box;user-select:none}
html,body,#game{margin:0;width:100%;height:100%;overflow:hidden}
body{background:#02030a;color:white;font-family:Arial,sans-serif}
#game{position:fixed;inset:0}

button{
  border:1px solid #ffffff25;
  border-radius:14px;
  background:#050505;
  color:#62aaff;
  font-weight:bold;
  padding:14px 18px;
  cursor:pointer
}

.screen{
  position:fixed;
  inset:0;
  z-index:20;
  display:flex;
  align-items:center;
  justify-content:center;
  background:
    radial-gradient(circle at 15% 20%,#713cff66,transparent 30%),
    radial-gradient(circle at 85% 25%,#168bff55,transparent 30%),
    radial-gradient(circle at 50% 90%,#c03cff44,transparent 35%),
    linear-gradient(135deg,#020208,#16102e,#03040a)
}

.panel{
  width:min(92vw,650px);
  padding:30px;
  border-radius:28px;
  background:#050509ed;
  border:1px solid #ffffff22;
  box-shadow:0 30px 100px #000
}

h1{text-align:center;font-size:clamp(48px,10vw,82px);margin:0}
.subtitle{text-align:center;opacity:.75;line-height:1.6}
.main{display:block;width:100%;margin:10px 0;padding:17px;font-size:18px}
.row{display:flex;gap:10px}.row button{flex:1}

#hud{
  display:none;
  position:fixed;
  z-index:10;
  top:12px;
  left:12px;
  right:12px;
  justify-content:space-between;
  pointer-events:none
}

#stats{
  min-width:300px;
  padding:11px;
  border-radius:15px;
  background:#000b;
  border:1px solid #ffffff25;
  font-size:13px;
  line-height:1.6
}

#health-bg{
  height:10px;
  background:#40151a;
  border-radius:10px;
  overflow:hidden
}

#health{
  width:100%;
  height:100%;
  background:#42e37a;
  transition:width .15s
}

#top{
  display:flex;
  gap:7px;
  pointer-events:auto
}

#top button{width:46px;height:46px;padding:0}

#controls{
  display:none;
  position:fixed;
  z-index:11;
  left:0;right:0;bottom:12px;
  height:160px;
  pointer-events:none
}

#joystick{
  position:absolute;
  left:15px;bottom:0;
  width:145px;height:145px;
  border-radius:50%;
  background:#000a;
  border:2px solid #ffffff22;
  pointer-events:auto
}

#knob{
  position:absolute;
  left:43px;top:43px;
  width:58px;height:58px;
  border-radius:50%;
  background:#111;
  border:2px solid #ffffff35
}

#actions{
  position:absolute;
  right:14px;bottom:4px;
  display:grid;
  grid-template-columns:repeat(2,82px);
  gap:8px;
  pointer-events:auto
}

#actions button{height:62px;padding:4px;font-size:10px}

#gameOver{display:none}

.monster-info{
  padding:10px;
  margin:6px 0;
  border-radius:10px;
  background:#11111a
}

@media(max-width:600px){
  #stats{min-width:245px;font-size:11px}
  .panel{padding:20px}
}
</style>
</head>

<body>

<div id="game"></div>

<!-- MENÚ -->

<section id="menu" class="screen">
  <div class="panel">

    <h1>Spirit 3000</h1>

    <p class="subtitle">
      Explora un mundo abierto, encuentra monstruos
      espirituales y atrápalos antes de que acaben contigo.
    </p>

    <button id="play" class="main">JUGAR</button>

    <div class="row">
      <button id="characters">CAMBIAR PERSONAJE</button>
      <button id="info">ESPÍRITUS</button>
    </div>

  </div>
</section>

<!-- INFORMACIÓN -->

<section id="information" class="screen" style="display:none">
  <div class="panel">

    <button id="closeInfo">CERRAR</button>

    <h2>50 monstruos espirituales</h2>

    <div id="monsterList"></div>

  </div>
</section>

<!-- PAUSA -->

<section id="pause" class="screen" style="display:none">
  <div class="panel">

    <h2>PAUSA</h2>

    <button id="resume" class="main">CONTINUAR</button>
    <button id="back" class="main">VOLVER</button>

  </div>
</section>

<!-- MUERTE -->

<section id="gameOver" class="screen">
  <div class="panel">

    <h2>HAS MUERTO</h2>

    <p>
      El espíritu te derrotó.
      Puedes volver a empezar o preparar una futura
      resurrección mediante la tienda.
    </p>

    <button id="restart" class="main">
      VOLVER A EMPEZAR
    </button>

    <button id="revive" class="main">
      REVIVIR — 0,99 €
    </button>

    <button id="deathBack" class="main">
      VOLVER AL MENÚ
    </button>

  </div>
</section>

<!-- HUD -->

<div id="hud">

  <div id="stats">

    ❤️ Vida:
    <b id="healthText">100%</b>

    <div id="health-bg">
      <div id="health"></div>
    </div>

    🔮 Cápsulas:
    <b id="capsules">25</b>

    · ✨ Éter:
    <b id="ether">0</b>

    · 👻 Capturados:
    <b id="captured">0</b>

    <br>

    🌍 Zona:
    <b id="zone">Pradera Central</b>

  </div>

  <div id="top">
    <button id="pauseButton">Ⅱ</button>
  </div>

</div>

<!-- CONTROLES -->

<div id="controls">

  <div id="joystick">
    <div id="knob"></div>
  </div>

  <div id="actions">

    <button id="throw">
      LANZAR
    </button>

    <button id="capture">
      ATRAPAR
    </button>

    <button id="etherButton">
      ÉTER
    </button>

    <button id="camera">
      CÁMARA
    </button>

  </div>

</div>


<script type="module">

import * as THREE from
"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js";


/* =========================
   ESCENA
========================= */

const scene =
  new THREE.Scene();

scene.background =
  new THREE.Color(0x07101b);

scene.fog =
  new THREE.Fog(
    0x07101b,
    30,
    300
  );


/* =========================
   CÁMARA
========================= */

const camera =
  new THREE.PerspectiveCamera(
    65,
    innerWidth / innerHeight,
    .1,
    1200
  );

camera.position.set(
  0,5,10
);


/* =========================
   RENDER
========================= */

const renderer =
  new THREE.WebGLRenderer({
    antialias:true
  });

renderer.setSize(
  innerWidth,
  innerHeight
);

renderer.setPixelRatio(
  Math.min(devicePixelRatio,2)
);

renderer.shadowMap.enabled=true;

document
  .getElementById("game")
  .appendChild(renderer.domElement);


/* =========================
   LUCES
========================= */

scene.add(
  new THREE.HemisphereLight(
    0xb9d5ff,
    0x152416,
    1.7
  )
);

const sun =
  new THREE.DirectionalLight(
    0xffedc4,
    2.5
  );

sun.position.set(
  -80,110,50
);

sun.castShadow=true;

scene.add(sun);


/* =========================
   TERRENO
========================= */

const ground =
  new THREE.Mesh(

    new THREE.PlaneGeometry(
      560,
      560
    ),

    new THREE.MeshStandardMaterial({
      color:0x183625,
      roughness:1
    })

  );

ground.rotation.x =
  -Math.PI/2;

ground.receiveShadow=true;

scene.add(ground);


/* =========================
   ZONAS
========================= */

const zones=[

  ["Pradera Central",0,0,110,0x355e2e],

  ["Bosque Sombrío",-155,-135,115,0x123b25],

  ["Valle de Nieve",160,-140,108,0xb8d4dc],

  ["Desierto Dorado",-160,160,108,0x9b7047],

  ["Tierras Volcánicas",160,160,108,0x451b1b],

  ["Pantano Azul",0,215,78,0x173d45],

  ["Montañas",0,-225,95,0x394454]

];


for(const z of zones){

  const mesh =
    new THREE.Mesh(

      new THREE.CircleGeometry(
        z[3],80
      ),

      new THREE.MeshStandardMaterial({
        color:z[4],
        roughness:1
      })

    );

  mesh.rotation.x=-Math.PI/2;

  mesh.position.set(
    z[1],
    .02,
    z[2]
  );

  scene.add(mesh);
}


/* =========================
   ÁRBOLES
========================= */

function tree(x,z,s){

  const group =
    new THREE.Group();

  const trunk =
    new THREE.Mesh(

      new THREE.CylinderGeometry(
        .3,.55,3.8,10
      ),

      new THREE.MeshStandardMaterial({
        color:0x50321e
      })

    );

  trunk.position.y=1.9;

  group.add(trunk);


  for(let i=0;i<4;i++){

    const leaves =
      new THREE.Mesh(

        new THREE.ConeGeometry(
          2.2-i*.3,
          3.2,
          12
        ),

        new THREE.MeshStandardMaterial({
          color:i%2
            ?0x155c31
            :0x0d4c2b
        })

      );

    leaves.position.y=
      3.2+i*1.2;

    group.add(leaves);

  }

  group.position.set(x,0,z);

  group.scale.setScalar(s);

  scene.add(group);
}


for(let i=0;i<360;i++){

  const x=
    (Math.random()-.5)*530;

  const z=
    (Math.random()-.5)*530;

  if(Math.hypot(x,z)<18)continue;

  tree(
    x,
    z,
    .55+Math.random()
  );
}


/* =========================
   TIPOS DE MONSTRUO
========================= */

const monsterTypes=[

  {
    name:"Bestia",
    color:0x9e4bff,
    size:1.2,
    horns:true,
    wings:false
  },

  {
    name:"Dragón",
    color:0xff553d,
    size:1.5,
    horns:true,
    wings:true
  },

  {
    name:"Lobo Espectral",
    color:0x7ccfff,
    size:1,
    horns:false,
    wings:false
  },

  {
    name:"Gólem",
    color:0x777777,
    size:1.7,
    horns:true,
    wings:false
  },

  {
    name:"Demonio",
    color:0xff205c,
    size:1.2,
    horns:true,
    wings:true
  },

  {
    name:"Araña Astral",
    color:0x55e69b,
    size:1,
    horns:false,
    wings:false
  },

  {
    name:"Serpiente",
    color:0xffd43d,
    size:1.1,
    horns:false,
    wings:false
  },

  {
    name:"Guardián",
    color:0x55a8ff,
    size:1.5,
    horns:true,
    wings:true
  }

];


/* =========================
   CREAR MONSTRUO
========================= */

function createMonster(type){

  const group=
    new THREE.Group();

  const material=
    new THREE.MeshStandardMaterial({
      color:type.color,
      emissive:type.color,
      emissiveIntensity:.18,
      roughness:.75
    });


  /* CUERPO */

  const body=
    new THREE.Mesh(

      new THREE.SphereGeometry(
        1,
        16,
        12
      ),

      material

    );

  body.scale.set(
    1,
    1.15,
    .8
  );

  body.position.y=1.3;

  group.add(body);


  /* CABEZA */

  const head=
    new THREE.Mesh(

      new THREE.SphereGeometry(
        .7,
        16,
        12
      ),

      material

    );

  head.position.set(
    0,
    2.35,
    -.25
  );

  group.add(head);


  /* OJOS */

  const eyeMaterial=
    new THREE.MeshBasicMaterial({
      color:0xffffff
    });

  const pupilMaterial=
    new THREE.MeshBasicMaterial({
      color:0x080808
    });


  for(const x of[-.25,.25]){

    const eye=
      new THREE.Mesh(

        new THREE.SphereGeometry(
          .13,10,8
        ),

        eyeMaterial

      );

    eye.position.set(
      x,
      2.4,
      -.88
    );

    group.add(eye);


    const pupil=
      new THREE.Mesh(

        new THREE.SphereGeometry(
          .06,8,8
        ),

        pupilMaterial

      );

    pupil.position.set(
      x,
      2.4,
      -.98
    );

    group.add(pupil);

  }


  /* PATAS */

  for(const x of[-.55,.55]){

    for(const z of[-.3,.3]){

      const leg=
        new THREE.Mesh(

          new THREE.CylinderGeometry(
            .15,.22,.9,8
          ),

          material

        );

      leg.position.set(
        x,
        .45,
        z
      );

      group.add(leg);

    }

  }


  /* CUERNOS */

  if(type.horns){

    for(const x of[-.35,.35]){

      const horn=
        new THREE.Mesh(

          new THREE.ConeGeometry(
            .15,
            .8,
            8
          ),

          material

        );

      horn.position.set(
        x,
        2.95,
        -.2
      );

      horn.rotation.z=
        x>0 ? -.3 : .3;

      group.add(horn);

    }

  }


  /* ALAS */

  if(type.wings){

    for(const x of[-1,1]){

      const wing=
        new THREE.Mesh(

          new THREE.ConeGeometry(
            .75,
            1.8,
            5
          ),

          material

        );

      wing.position.set(
        x,
        1.9,
        .2
      );

      wing.rotation.z=
        x>0 ? -.8 : .8;

      group.add(wing);

    }

  }


  /* COLA */

  const tail=
    new THREE.Mesh(

      new THREE.ConeGeometry(
        .22,
        1.6,
        8
      ),

      material

    );

  tail.position.set(
    0,
    1,
    .9
  );

  tail.rotation.x=
    Math.PI/2;

  group.add(tail);


  group.scale.setScalar(
    type.size
  );


  return group;

}


/* =========================
   CREAR 50 MONSTRUOS
========================= */

const monsters=[];

for(let i=0;i<50;i++){

  const type=
    monsterTypes[
      i%monsterTypes.length
    ];

  const object=
    createMonster(type);

  object.position.set(

    (Math.random()-.5)*510,

    0,

    (Math.random()-.5)*510

  );

  scene.add(object);


  monsters.push({

    object,

    name:
      type.name+
      " "+(i+1),

    level:
      1+Math.floor(i/7),

    health:
      100+Math.floor(i/7)*30,

    maxHealth:
      100+Math.floor(i/7)*30,

    damage:
      5+Math.floor(i/8)*2,

    active:true,

    attackCooldown:0,

    direction:
      new THREE.Vector3(
        Math.random()-.5,
        0,
        Math.random()-.5
      ).normalize()

  });

}


/* =========================
   PERSONAJE
========================= */

const player=
  new THREE.Group();


const playerBody=
  new THREE.Mesh(

    new THREE.BoxGeometry(
      .8,1.1,.55
    ),

    new THREE.MeshStandardMaterial({
      color:0x327bd8
    })

  );

playerBody.position.y=1.5;

player.add(playerBody);


const playerHead=
  new THREE.Mesh(

    new THREE.SphereGeometry(
      .5,16,12
    ),

    new THREE.MeshStandardMaterial({
      color:0xd79b74
    })

  );

playerHead.position.y=2.45;

player.add(playerHead);


scene.add(player);


/* =========================
   ESTADO
========================= */

let hp=100;

let capsules=25;

let ether=0;

let captured=0;

let playing=false;

let paused=false;

let cameraMode=0;

let gameTime=0;

const keys={
  w:false,
  a:false,
  s:false,
  d:false
};


/* =========================
   MOVIMIENTO RÁPIDO
========================= */

const PLAYER_SPEED=11;


/* =========================
   ATAQUE DE MONSTRUOS
========================= */

function updateMonsters(delta){

  for(const monster of monsters){

    if(!monster.active)
      continue;


    monster.attackCooldown=
      Math.max(
        0,
        monster.attackCooldown-delta
      );


    const distance=
      monster.object.position.distanceTo(
        player.position
      );


    /* PERSEGUIR */

    if(distance<38){

      const direction=
        player.position.clone()
        .sub(
          monster.object.position
        );

      direction.y=0;

      if(direction.length()>0)
        direction.normalize();


      monster.object.position
        .addScaledVector(
          direction,
          delta*
          (
            3.2+
            monster.level*.15
          )
        );

    }


    /* ATAQUE */

    if(
      distance<3.2 &&
      monster.attackCooldown<=0
    ){

      hp=
        Math.max(
          0,
          hp-monster.damage
        );

      monster.attackCooldown=
        1.0;

    }

  }

}


/* =========================
   CAPTURAR
========================= */

function nearestMonster(){

  let nearest=null;
  let distance=Infinity;

  for(const monster of monsters){

    if(!monster.active)
      continue;

    const d=
      monster.object.position
      .distanceTo(
        player.position
      );

    if(d<distance){

      distance=d;
      nearest=monster;

    }

  }

  return{
    monster:nearest,
    distance
  };

}


function captureMonster(){

  if(capsules<=0)
    return;


  const result=
    nearestMonster();


  if(
    !result.monster ||
    result.distance>7
  )
    return;


  capsules--;


  result.monster.health=
    Math.max(
      0,
      result.monster.health-45
    );


  if(
    result.monster.health<=0
  ){

    result.monster.active=false;

    result.monster.object.visible=false;

    captured++;

  }

}


/* =========================
   LANZAR
========================= */

function throwCapsule(){

  if(capsules<=0)
    return;

  const result=
    nearestMonster();

  if(
    !result.monster ||
    result.distance>12
  )
    return;

  capsules--;

  result.monster.health=
    Math.max(
      0,
      result.monster.health-65
    );

}


/* =========================
   TECLADO
========================= */

addEventListener(
  "keydown",
  e=>{

    const k=
      e.key.toLowerCase();

    if(k==="w"||k==="arrowup")
      keys.w=true;

    if(k==="a"||k==="arrowleft")
      keys.a=true;

    if(k==="s"||k==="arrowdown")
      keys.s=true;

    if(k==="d"||k==="arrowright")
      keys.d=true;

    if(k==="q")
      throwCapsule();

    if(k==="e")
      captureMonster();

    if(k==="c")
      cameraMode=
        (cameraMode+1)%3;

  }
);


addEventListener(
  "keyup",
  e=>{

    const k=
      e.key.toLowerCase();

    if(k==="w"||k==="arrowup")
      keys.w=false;

    if(k==="a"||k==="arrowleft")
      keys.a=false;

    if(k==="s"||k==="arrowdown")
      keys.s=false;

    if(k==="d"||k==="arrowright")
      keys.d=false;

  }
);


/* =========================
   JOYSTICK
========================= */

const joystick=
  document.getElementById(
    "joystick"
  );

const knob=
  document.getElementById(
    "knob"
  );

let pointer=null;


joystick.addEventListener(
  "pointerdown",
  e=>{

    pointer=e.pointerId;

    joystick.setPointerCapture(
      pointer
    );

    joystickMove(e);

  }
);


joystick.addEventListener(
  "pointermove",
  e=>{

    if(e.pointerId===pointer)
      joystickMove(e);

  }
);


joystick.addEventListener(
  "pointerup",
  joystickReset
);


function joystickMove(e){

  const r=
    joystick.getBoundingClientRect();

  const dx=
    e.clientX-
    r.left-
    r.width/2;

  const dy=
    e.clientY-
    r.top-
    r.height/2;

  const length=
    Math.min(
      50,
      Math.hypot(dx,dy)
    );

  const angle=
    Math.atan2(dy,dx);

  knob.style.left=
    43+
    Math.cos(angle)*length+
    "px";

  knob.style.top=
    43+
    Math.sin(angle)*length+
    "px";

  keys.a=dx<-18;
  keys.d=dx>18;
  keys.w=dy<-18;
  keys.s=dy>18;

}


function joystickReset(){

  pointer=null;

  knob.style.left="43px";
  knob.style.top="43px";

  keys.w=
  keys.a=
  keys.s=
  keys.d=false;

}


/* =========================
   ACTUALIZAR
========================= */

function update(delta){

  if(!playing||paused)
    return;


  const forward=
    (keys.w?1:0)-
    (keys.s?1:0);

  const sideways=
    (keys.d?1:0)-
    (keys.a?1:0);


  player.position.z+=
    forward*
    PLAYER_SPEED*
    delta;


  player.position.x+=
    sideways*
    PLAYER_SPEED*
    delta;


  player.position.x=
    THREE.MathUtils.clamp(
      player.position.x,
      -270,270
    );

  player.position.z=
    THREE.MathUtils.clamp(
      player.position.z,
      -270,270
    );


  updateMonsters(delta);


  gameTime+=delta;


  const daylight=
    (Math.sin(
      gameTime*.12
    )+1)/2;


  sun.intensity=
    .35+
    daylight*2.2;


  scene.background.setHSL(
    .62,
    .44,
    .025+
    daylight*.055
  );


  scene.fog.color.copy(
    scene.background
  );


  /* CÁMARA */

  const target=
    new THREE.Vector3(
      player.position.x,
      1.4,
      player.position.z
    );


  const distance=
    cameraMode===2
      ?4
      :cameraMode===1
        ?16
        :10;


  camera.position.lerp(

    target.clone().add(
      new THREE.Vector3(
        0,
        cameraMode===2?2.8:5,
        distance
      )
    ),

    .1

  );


  camera.lookAt(target);


  /* HUD */

  document.getElementById(
    "healthText"
  ).textContent=
    Math.round(hp)+"%";

  document.getElementById(
    "health"
  ).style.width=
    hp+"%";

  document.getElementById(
    "capsules"
  ).textContent=
    capsules;

  document.getElementById(
    "ether"
  ).textContent=
    ether;

  document.getElementById(
    "captured"
  ).textContent=
    captured;


  /* MUERTE */

  if(hp<=0){

    die();

  }

}


/* =========================
   MORIR
========================= */

function die(){

  playing=false;

  document.getElementById(
    "hud"
  ).style.display="none";

  document.getElementById(
    "controls"
  ).style.display="none";

  document.getElementById(
    "gameOver"
  ).style.display="flex";

}


/* =========================
   REINICIAR
========================= */

function restart(){

  hp=100;

  player.position.set(
    0,0,0
  );

  for(const monster of monsters){

    monster.active=true;
    monster.health=
      monster.maxHealth;

    monster.object.visible=true;

  }

  playing=true;

  document.getElementById(
    "gameOver"
  ).style.display="none";

  document.getElementById(
    "hud"
  ).style.display="flex";

  document.getElementById(
    "controls"
  ).style.display="block";

}


/* =========================
   BOTONES
========================= */

document.getElementById(
  "play"
).onclick=()=>{

  playing=true;

  document.getElementById(
    "menu"
  ).style.display="none";

  document.getElementById(
    "hud"
  ).style.display="flex";

  document.getElementById(
    "controls"
  ).style.display="block";

};


document.getElementById(
  "throw"
).onclick=
  throwCapsule;


document.getElementById(
  "capture"
).onclick=
  captureMonster;


document.getElementById(
  "camera"
).onclick=()=>{

  cameraMode=
    (cameraMode+1)%3;

};


document.getElementById(
  "pauseButton"
).onclick=()=>{

  paused=true;

  document.getElementById(
    "pause"
  ).style.display="flex";

};


document.getElementById(
  "resume"
).onclick=()=>{

  paused=false;

  document.getElementById(
    "pause"
  ).style.display="none";

};


document.getElementById(
  "back"
).onclick=()=>{

  paused=false;
