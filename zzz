/* =========================
   INFORMACIÓN
========================= */

document.getElementById(
  "info"
).onclick=()=>{

  const section=
    document.getElementById(
      "information"
    );

  section.style.display="flex";


  const list=
    document.getElementById(
      "monsterList"
    );

  list.innerHTML="";


  monsters.forEach(
    (monster,i)=>{

      const item=
        document.createElement(
          "div"
        );

      item.className=
        "monster-info";

      item.innerHTML=
        "<b>"+
        (i+1)+
        ". "+
        monster.name+
        "</b><br>Nivel "+
        monster.level+
        " · Vida "+
        monster.maxHealth;

      list.appendChild(item);

    }
  );

};


document.getElementById(
  "closeInfo"
).onclick=()=>{

  document.getElementById(
    "information"
  ).style.display="none";

};


/* =========================
   BUCLE
========================= */

let last=performance.now();

function loop(now){

  requestAnimationFrame(loop);

  const delta=
    Math.min(
      .05,
      (now-last)/1000
    );

  last=now;

  update(delta);

  renderer.render(
    scene,
    camera
  );

}

requestAnimationFrame(loop);


/* =========================
   RESIZE
========================= */

addEventListener(
  "resize",
  ()=>{

    camera.aspect=
      innerWidth/
      innerHeight;

    camera.updateProjectionMatrix();

    renderer.setSize(
      innerWidth,
      innerHeight
    );

  }
);

</script>

