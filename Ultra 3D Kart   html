// ---------------- ROAD MOTION EFFECT ----------------
const roadMarks=[];
for(let z=-480;z<40;z+=18){
 const mark=new THREE.Mesh(
   new THREE.BoxGeometry(.28,.06,7),
   new THREE.MeshStandardMaterial({color:0xffffff})
 );
 mark.position.set(0,.08,z);
 scene.add(mark);
 roadMarks.push(mark);
}
function animateRoad(){
 roadMarks.forEach(mark=>{
   mark.position.z += speed*3.0;
   if(mark.position.z>25) mark.position.z=-480;
 });
}

function car(color){const g=new THREE.Group(),m=new THREE.MeshStandardMaterial({color,metalness:.25,roughness:.35}),b=new THREE.Mesh(new THREE.BoxGeometry(2.05,.65,4),m),c=new THREE.Mesh(new THREE.BoxGeometry(1.45,.6,1.7),new THREE.MeshStandardMaterial({color:0x172a3a,metalness:.5,roughness:.15}));b.position.y=.75;c.position.set(0,1.25,-.15);g.add(b,c);const wm=new THREE.MeshStandardMaterial({color:0x111111});for(const x of[-1.05,1.05])for(const z of[-1.25,1.25]){const w=new THREE.Mesh(new THREE.CylinderGeometry(.42,.42,.28,16),wm);w.rotation.z=Math.PI/2;w.position.set(x,.48,z);g.add(w)}return g}const player=car(0x2196f3);player.position.set(0,0,8);scene.add(player);const rivals=[[-3.2,-20,0xe53935,.16],[0,-45,0xffc107,.18],[3.2,-70,0x8e44ad,.21]].map(a=>{const m=car(a[2]);m.position.set(a[0],0,a[1]);scene.add(m);return{mesh:m,lane:a[0],speed:a[3]}});const keys={left:false,right:false,up:false,down:false,turbo:false};let run=false,x=0,speed=.12,boost=100,coins=0;function key(n,v){keys[n]=v}addEventListener('keydown',e=>{if(e.key==='ArrowLeft')key('left',1);if(e.key==='ArrowRight')key('right',1);if(e.key==='ArrowUp')key('up',1);if(e.key==='ArrowDown')key('down',1);if(e.code==='Space')key('turbo',1)});addEventListener('keyup',e=>{if(e.key==='ArrowLeft')key('left',0);if(e.key==='ArrowRight')key('right',0);if(e.key==='ArrowUp')key('up',0);if(e.key==='ArrowDown')key('down',0);if(e.code==='Space')key('turbo',0)});function hold(id,n){const e=document.getElementById(id);['pointerdown'].forEach(v=>e.addEventListener(v,()=>key(n,1)));['pointerup','pointerleave','pointercancel'].forEach(v=>e.addEventListener(v,()=>key(n,0)))}hold('left','left');hold('right','right');hold('turbo','turbo');document.getElementById('start').onclick=()=>{document.getElementById('menu').style.display='none';const cd=document.getElementById('countdown');cd.style.display='flex';let n=3;cd.textContent=n;const t=setInterval(()=>{n--;if(n>0)cd.textContent=n;else if(n===0)cd.textContent='¡YA!';else{clearInterval(t);cd.style.display='none';run=true}},800)};document.getElementById('cars').onclick=()=>alert('Garaje: aquí añadiremos los 10 coches y sus precios.');
function update(){if(!run)return;let target=keys.up?.24:.14;if(keys.down)target=.06;if(keys.turbo&&boost>0){target=.40;boost=Math.max(0,boost-.55)}else boost=Math.min(100,boost+.12);speed+=(target-speed)*.035;if(keys.left)x-=.095*(speed/.14);if(keys.right)x+=.095*(speed/.14);x=Math.max(-5.4,Math.min(5.4,x));player.position.x+=(x-player.position.x)*.18;for(const r of rivals){r.mesh.position.z+=speed-r.speed;if(r.mesh.position.z>16){r.mesh.position.z=-180-Math.random()*120;r.lane=[-3.2,0,3.2][Math.floor(Math.random()*3)];r.mesh.position.x=r.lane}r.mesh.position.x+=(r.lane-r.mesh.position.x)*.03;if(Math.abs(r.mesh.position.x-player.position.x)<1.7&&Math.abs(r.mesh.position.z-player.position.z)<2.7) speed*=.88}if(Math.random()<.002)coins++;document.getElementById('stats').textContent=`💰 ${coins} · 🏎️ 1/4 · ⚡ ${Math.round(boost)}%`;camera.position.x+=(player.position.x*.42-camera.position.x)*.08;camera.position.y+=(5.2-camera.position.y)*.06;camera.position.z+=(11.5-camera.position.z)*.06;camera.lookAt(player.position.x,1,-8)}function animate(){requestAnimationFrame(animate);update();renderer.render(scene,camera)}animate();addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight)})</script>
